<UserControl x:Class="GeneradorFIT.Views.GeneradorFitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800"
             Background="{StaticResource BackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" Width="480">
            <!-- Header -->
            <TextBlock Text="Generador FIT"
                      Style="{StaticResource TitleTextStyle}"/>

            <!-- Origin File Card -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Excel Origen"
                              Style="{StaticResource SubtitleTextStyle}"/>

                    <TextBlock Text="RUTA DEL ARCHIVO ORIGEN"
                              Style="{StaticResource LabelTextStyle}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                Text="{Binding RutaOrigen, UpdateSourceTrigger=PropertyChanged}"
                                materialDesign:HintAssist.Hint="Selecciona el archivo Excel de origen"
                                IsReadOnly="True"
                                Margin="0,0,8,0"/>

                        <Button Grid.Column="1"
                               Command="{Binding BuscarOrigenCommand}"
                               Style="{StaticResource MaterialDesignRaisedButton}"
                               materialDesign:ButtonAssist.CornerRadius="4"
                               Height="40">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FolderOpen"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"/>
                                <TextBlock Text="Examinar..." VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Destination File Card -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Excel Destino (Guardar como)"
                              Style="{StaticResource SubtitleTextStyle}"/>

                    <TextBlock Text="RUTA DEL ARCHIVO DESTINO"
                              Style="{StaticResource LabelTextStyle}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                Text="{Binding RutaDestino, UpdateSourceTrigger=PropertyChanged}"
                                materialDesign:HintAssist.Hint="Selecciona la ruta de destino para guardar"
                                IsReadOnly="True"
                                Margin="0,0,8,0"/>

                        <Button Grid.Column="1"
                               Command="{Binding BuscarDestinoCommand}"
                               Style="{StaticResource MaterialDesignRaisedButton}"
                               materialDesign:ButtonAssist.CornerRadius="4"
                               Height="40">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FolderOpen"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"/>
                                <TextBlock Text="Examinar..." VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Configuration Card -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Configuración"
                              Style="{StaticResource SubtitleTextStyle}"/>

                    <TextBlock Text="NÚMERO DE REFERENCIAS"
                              Style="{StaticResource LabelTextStyle}"/>

                    <TextBox Text="{Binding Referencias, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Ej: 8"
                             FontSize="14"
                             Width="150"
                             HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <!-- Action Card -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <Button Command="{Binding GenerarCommand}"
                           Style="{StaticResource MaterialDesignRaisedButton}"
                           materialDesign:ButtonAssist.CornerRadius="4"
                           Height="48"
                           FontSize="15"
                           IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBooleanConverter}}"
                           Background="{StaticResource PrimaryBrush}"
                           BorderBrush="{StaticResource PrimaryBrush}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileExcel"
                                                   Width="24"
                                                   Height="24"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,0"/>
                            <TextBlock Text="Generar Excel"
                                      VerticalAlignment="Center"
                                      FontWeight="Medium"/>
                        </StackPanel>
                    </Button>

                    <!-- Status -->
                    <StackPanel Orientation="Horizontal"
                               Margin="0,16,0,0"
                               Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                    Value="0"
                                    IsIndeterminate="True"
                                    Width="24"
                                    Height="24"
                                    Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding Estado}"
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource PrimaryBrush}"/>
                    </StackPanel>

                    <TextBlock Text="{Binding Estado}"
                              VerticalAlignment="Center"
                              Margin="0,16,0,0"
                              Foreground="{StaticResource TextSecondaryBrush}"
                              Visibility="{Binding IsProcessing, Converter={StaticResource InverseBoolToVisConverter}}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
